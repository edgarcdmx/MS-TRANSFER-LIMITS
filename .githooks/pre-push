#!/usr/bin/env bash
# Native git pre-push hook for MS-TRANSFER-LIMITS (blocks pushes made outside Claude Code too).
# Activate once per clone:  bash scripts/install-hooks.sh   (= git config core.hooksPath .githooks)
# Requires every pushed commit (local sha of each ref on stdin) to be the one approved in
# target/review/REVIEW_OK (written by the code-security-reviewer subagent when APPROVED), that
# approval to match HEAD (the working tree the gate checks), and scripts/quality-gate.sh to pass.
# Bypassing with --no-verify is forbidden by project policy (CLAUDE.md). Hooks are guardrails;
# real enforcement is GitHub branch protection with required CI checks.
set -u

ROOT="$(git rev-parse --show-toplevel)" || exit 1
# shellcheck source=../scripts/lib/common.sh
. "$ROOT/scripts/lib/common.sh"

# Read the refs being pushed (stdin): "<local ref> <local sha> <remote ref> <remote sha>".
# A push that only deletes remote refs carries no code; let it through.
ZERO="0000000000000000000000000000000000000000"
pushed_shas=()
saw_ref=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  saw_ref=1
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue
  pushed_shas+=("$local_sha ${local_ref:-?}")
done
if [ "$saw_ref" -eq 1 ] && [ "${#pushed_shas[@]}" -eq 0 ]; then
  exit 0
fi

# Fail fast (before the slow gate): every pushed commit must be the approved one.
for entry in "${pushed_shas[@]}"; do
  sha="${entry%% *}"
  ref="${entry#* }"
  if ! review_ok_matches_sha "$ROOT" "$sha"; then
    echo "[pre-push] BLOCKED: $ref ($sha) is not the commit approved by code-security-reviewer." >&2
    exit 1
  fi
done
if ! review_ok_matches_head "$ROOT"; then
  echo "[pre-push] BLOCKED: no APPROVED code-security-reviewer verdict for HEAD." >&2
  exit 1
fi

echo "[pre-push] running quality gate ..." >&2
# QG_REUSE=1: if the Claude Code PreToolUse hook already ran the gate for this exact
# HEAD + working tree, do not run the full build twice.
if ! QG_REUSE=1 bash "$ROOT/scripts/quality-gate.sh" 1>&2; then
  echo "[pre-push] BLOCKED: quality gate failed. Fix, commit and push again." >&2
  exit 1
fi

echo "[pre-push] OK: quality gate passed and review approved for the pushed commit(s)." >&2
exit 0
