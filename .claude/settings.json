{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw)",
      "Bash(./mvnw *)",
      "Bash(mvnw.cmd)",
      "Bash(mvnw.cmd *)",
      "Bash(bash scripts/quality-gate.sh)",
      "Bash(bash scripts/install-hooks.sh)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git rev-parse*)",
      "mcp__github__*",
      "mcp__context7__*",
      "mcp__fetch__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(*--no-verify*)",
      "Bash(rm -rf /*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/pre-push-gate.sh\"",
            "timeout": 1200,
            "statusMessage": "pre-push gate: quality gate + reviewer approval"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/protect-files.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/format-java.sh\"",
            "timeout": 180,
            "statusMessage": "google-java-format (spotless:apply)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/remind-gate.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
