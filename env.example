# Copy to .env (cp env.example .env) and change the values before `docker compose up`.
# .env is git-ignored; never commit real credentials.

# PostgreSQL credentials used by both the postgres and app services in compose.yaml.
POSTGRES_USER=transfer
POSTGRES_PASSWORD=change-me

# Only needed when running the app outside Docker (./mvnw spring-boot:run):
# DB_URL=jdbc:postgresql://localhost:5432/transfer_limits
# DB_USERNAME=transfer
# DB_PASSWORD=change-me
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
